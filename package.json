{
  "name": "upsihub",
  "version": "2.0.0",
  "description": "UPSIHub - platform dalam talian sepenuhnya untuk pelajar UPSI: pasar kampus, pesanan, dompet digital & chat dalaman.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --test",
    "build:gas": "node gas/build.mjs",
    "test:gas": "node gas/build.mjs && UPSIHUB_SERVER=gas/harness/server.mjs node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
